{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc --noEmit)",
      "Bash(node .claude/skills/*)",
      "Bash(node _*.mjs*)",
      "Bash(python3 -m http.server *)",
      "Bash(curl -s https://xxli807.github.io/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull --rebase*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Read(./art-source/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)"
    ]
  }
}
